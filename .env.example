# Majordomo configuration.
# Copy this file to .env and fill in the blanks:   cp .env.example .env
# .env is listed in .gitignore and must never be committed (SEC-1).

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# personal = one user, no sign-in, runs on your own machine with your own keys.
# hosted   = shared instance. Requires HTTPS (SEC-4) and an access code until
#            proper sign-in arrives in phase 2.
MAJORDOMO_MODE=personal

# ---------------------------------------------------------------------------
# LiveKit (real-time audio). Get these from https://cloud.livekit.io
# Project -> Settings -> Keys. Use the wss:// URL shown there.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Google Gemini Live. Get a key from https://aistudio.google.com/apikey
# Free-tier keys are fine for your own testing. Use a paid key before other
# people use a hosted instance (their content must not go through a free key).
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
# Realtime model and voice. Leave blank to use the defaults in agent/config.py.
GEMINI_MODEL=
GEMINI_VOICE=Charon

# ---------------------------------------------------------------------------
# Persona
# ---------------------------------------------------------------------------
# How Domo addresses you: a name ("Stan"), a title ("Sir", "Doctor"), or blank
# for nothing at all.
MAJORDOMO_USER_ADDRESS=
# How long a pause (in milliseconds) means you've finished speaking.
# Lower = Domo answers sooner but may cut you off.
MAJORDOMO_SILENCE_MS=600

# ---------------------------------------------------------------------------
# Token backend
# ---------------------------------------------------------------------------
# How long a LiveKit access token handed to the browser stays valid, in seconds.
TOKEN_TTL_SECONDS=600
# Cost guard: Domo ends a conversation after this many minutes (SEC-3).
MAJORDOMO_MAX_SESSION_MINUTES=60
# Hosted mode only: visitors must enter this code before they get a token.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MAJORDOMO_ACCESS_CODE=
# Comma-separated list of web origins allowed to call the backend.
# Leave blank in personal mode (the web app and backend share an origin).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Port the web app is published on, on the host machine.
WEB_PORT=8080
# Personal mode: leave as :80. Hosted mode with your own domain: set it to the
# domain (e.g. domo.example.com) and Caddy will get an HTTPS certificate.
SITE_ADDRESS=:80

# ---------------------------------------------------------------------------
# Images (only needed if you pull prebuilt images instead of building)
# ---------------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/stanleyhughes/majordomo
IMAGE_TAG=latest
